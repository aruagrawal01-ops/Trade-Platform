# Copy to .env for local dev, or set these in Vercel > Project > Settings > Environment Variables.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/stock_db
JWT_SECRET_KEY=change-me
ANTHROPIC_API_KEY=sk-ant-...       # required for the /api/ai/* AI analyst routes
AI_MODEL=claude-opus-5            # optional; e.g. claude-sonnet-5 for lower cost
